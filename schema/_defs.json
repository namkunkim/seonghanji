{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seonghanji.local/schema/_defs.json",
  "title": "공용 정의",
  "description": "ID 패턴과 반복 타입. data-model.md §2.1 규칙 — 불변 · 결번 재사용 금지 · 번호는 의미 없음",
  "$defs": {
    "sysId": {
      "type": "string",
      "pattern": "^SYS-(0[1-9]|1[0-9])$",
      "description": "성계 19. 성역은 같은 대상의 행정 명칭 — 별도 ID 없음"
    },
    "rgnId": {
      "type": "string",
      "pattern": "^RGN-(0[1-9]|[1-3][0-9]|4[0-5])$",
      "description": "권역 45. 지배의 최소 단위"
    },
    "corId": {
      "type": "string",
      "pattern": "^COR-(0[1-9]|1[0-5])$",
      "description": "회랑 15"
    },
    "rteId": {
      "type": "string",
      "pattern": "^RTE-[0-9]{3}$",
      "description": "항로. 회랑과 분리 (data-model.md §1.3)"
    },
    "chrId": {
      "type": "string",
      "pattern": "^CHR-[0-9]{4}$",
      "description": "인물 492. 단일 번호 공간 (data-model.md §2.3)"
    },
    "scnId": {
      "type": "string",
      "pattern": "^SCN-0[1-6]$"
    },
    "actId": {
      "type": "string",
      "pattern": "^ACT-(0[1-9]|[1-5][0-9]|6[0-8])$",
      "description": "전역 연속 (data-model.md §2.4)"
    },
    "fId": {
      "type": "string",
      "pattern": "^F-(0[1-9]|[1-3][0-9]|40)$",
      "description": "기능 이벤트 40. 기존 체계 유지"
    },
    "shpId": {
      "type": "string",
      "pattern": "^SHP-0[1-6]$",
      "description": "함종 6"
    },
    "frmId": {
      "type": "string",
      "pattern": "^FRM-0[1-7]$",
      "description": "진형 7"
    },
    "grade": {
      "enum": [
        "특급",
        "1급",
        "2급"
      ]
    },
    "level": {
      "enum": [
        "극상",
        "상",
        "중",
        "하"
      ],
      "description": "수준 4단. 「극상」은 남정권·합비권·양평권의 방어, 익주군권·월수권의 개발여지에 실제로 쓰인다 (region-power.md §2)"
    },
    "phaseCoeff": {
      "type": "object",
      "required": [
        "contact",
        "barrage",
        "engagement",
        "assault",
        "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "contact": {
          "type": "number",
          "minimum": 0
        },
        "barrage": {
          "type": "number",
          "minimum": 0
        },
        "engagement": {
          "type": "number",
          "minimum": 0
        },
        "assault": {
          "type": "number",
          "minimum": 0
        },
        "resolution": {
          "type": "number",
          "minimum": 0
        }
      },
      "description": "① 접적 ② 포화 ③ 교전 ④ 강습 ⑤ 결착"
    }
  }
}
