class_name Mandate
extends RefCounted

## 천명(Mandate) — 0~100 (function-events.md §0.3-①)
##
## **세력마다 하나씩 갖는 수치이고, 사기에 직접 들어간다** (`combat.md` §1.1).
##
## > **천명이 사기에 직접 들어간다는 것이 이 설계의 핵심이다.**
## > 「무엇이 통치의 정당한 근거인가」라는 주제가 전장에서 수치로 작동한다.
## > **명분 없는 군대는 같은 함선 수로도 먼저 무너진다.**
##
## 2026-08-25 신설. 그때까지 천명은 **문서에만 있었다** —
## 눈금도 산식도 확정되어 있었는데 코드가 한 번도 읽지 않았다.
## 그래서 조조의 이점(황제 보유 · 승상)이 전투에 하나도 반영되지 않고 있었다.

const MIN: int = 0
const MAX: int = 100

## 구간 하한 → [명칭, 사기 보정]. **순서를 고정한다** — 높은 쪽부터
const BANDS: Array = [
	[85, "수명", 15],
	[70, "정통", 8],
	[50, "명분", 3],
	[30, "실력", -3],
	[15, "참칭", -8],
	[0, "무도", -15],
]


static func band(value: int) -> String:
	for b in BANDS:
		if value >= int(b[0]):
			return String(b[1])
	return "무도"


## 사기 보정. **±15 로 묶여 있다** —
## `combat.md` 검토 2(「과하면 전투가 정치의 종속물이 된다」)를 그대로 채택한 값이다.
static func morale_bonus(value: int) -> int:
	for b in BANDS:
		if value >= int(b[0]):
			return int(b[2])
	return -15


## ---------------------------------------------------------------- 초기값
##
## 캠페인 개시(190) 시의 표. [F-01] 이 쓴다.
##
## > **어느 세력도 50 을 넘지 않는다.**
## > 프롤로그가 끝난 천하에는 정통이 남아 있지 않다 —
## > 그것이 [F-01] 이 말하는 상태다.
const INITIAL := {
	"황제보유": 45,
	"한실종친": 40,
	"사세삼공": 35,
	"관직자립": 28,
	"무관직자립": 20,
	"이민족": 12,
}


## 시나리오 3(208)의 천명. 개시표가 아니라 **18년이 지난 뒤의 값**이다.
##
## 조조 62 · 손유 48 은 `combat.md` §5.7 이 적벽 검산의 전제로 쓴 값을 그대로 쓴다.
## 나머지는 §0.3-① 의 신분 구분을 따른다 —
## 유장은 유언의 아들이라 한실 종친(40), 나머지는 관직 자립(28)이다.
##
## ⚠ **§5.7 스스로 「이 예시의 전제이며 확정값이 아니다」라고 적었다.**
## 시나리오별 천명표가 정본에 없으므로 **여기가 사실상 그 자리를 대신한다.**
const SCN03 := {
	"조조": 62,        # 황제 보유 · 승상. 「명분」 구간 → 사기 +3
	"손권": 48,        # 강동 자립. 「실력」 구간 → 사기 −3
	"유종": 48,        # 형주 계승 명분과 항복 사이
	"유장": 40,        # 유언의 아들 — 한실 종친
	"장로": 28,        # 진민중랑장 — 관직 자립
	"마등한수": 28,    # 정서장군
	"사섭": 28,        # 교지태수
	"공손강": 28,      # 요동태수
}


static func scenario_03(fid: String) -> int:
	return int(SCN03.get(fid, INITIAL["관직자립"]))


## 초기 사기. **명목 100 에 천명 보정이 얹힌다** (`combat.md` §1.2).
##
## 100 은 상한이 아니라 **「아무것도 더하지도 빼지도 않은 군대」**다.
static func initial_morale(mandate: int) -> int:
	return clampi(Battle.MORALE_NOMINAL + morale_bonus(mandate),
		0, Battle.MORALE_MAX)
